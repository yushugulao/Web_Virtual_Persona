# Copy to .env on Windows and edit locally. Do not commit .env.
# You can also run scripts\deploy\portable_deploy.ps1 to generate local overrides.

PERSONA_RAG_ENV=dev
PERSONA_RAG_HOST=127.0.0.1
PERSONA_RAG_PORT=8000
PERSONA_RAG_SQLITE_PATH=data/sqlite/persona_rag.sqlite3

PERSONA_RAG_MODEL_PROVIDER=ollama
PERSONA_RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
PERSONA_RAG_OLLAMA_MODELS_DIR=models/ollama
PERSONA_RAG_LOW_GENERATION_MODEL=qwen3.5:9b
PERSONA_RAG_MEDIUM_GENERATION_MODEL=qwen3.5:9b
PERSONA_RAG_HIGH_GENERATION_MODEL=qwen3.5:9b
PERSONA_RAG_LOW_GENERATION_THINKING_BUDGET=600
PERSONA_RAG_MEDIUM_GENERATION_THINKING_BUDGET=2000
PERSONA_RAG_HIGH_GENERATION_THINKING_BUDGET=4000
PERSONA_RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b

PERSONA_RAG_AUTH_REQUIRED=true
PERSONA_RAG_AUTH_ADMIN_USERNAME=admin
PERSONA_RAG_AUTH_ADMIN_EMAIL=admin@local.persona-rag
PERSONA_RAG_AUTH_ADMIN_PASSWORD=change_me_in_local_env

PERSONA_RAG_SMTP_HOST=
PERSONA_RAG_SMTP_PORT=465
PERSONA_RAG_SMTP_SECURITY=ssl
PERSONA_RAG_SMTP_USERNAME=
PERSONA_RAG_SMTP_PASSWORD=
PERSONA_RAG_SMTP_FROM=

PERSONA_RAG_DEEPSEEK_API_KEY=
DOCUMENT_READER_MODEL_CACHE_DIR=models/document_reader
DOCUMENT_READER_ENABLE_MARKER_SURYA=false

VITE_API_BASE_URL=http://127.0.0.1:8000

# Portable deployment metadata. These are optional and may be generated by the deploy wizard.
PERSONA_RAG_PUBLIC_URL=
PERSONA_RAG_DEPLOYMENT_MODE=local_lan
PERSONA_RAG_DEPLOYMENT_PROFILE=standard_gpu
