# Backend
PERSONA_RAG_ENV=dev
PERSONA_RAG_HOST=127.0.0.1
PERSONA_RAG_PORT=8000
PERSONA_RAG_CORPUS_DIR=corpus
PERSONA_RAG_DATA_DIR=data
PERSONA_RAG_SQLITE_PATH=data/sqlite/persona_rag.sqlite3

# Local model
PERSONA_RAG_MODEL_PROVIDER=ollama
PERSONA_RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
PERSONA_RAG_OLLAMA_MODELS_DIR=models/ollama
PERSONA_RAG_GENERATION_MODEL=qwen3.5:9b
PERSONA_RAG_QUALITY_GENERATION_MODEL=
PERSONA_RAG_QUALITY_GENERATION_MIN_EFFORT=high
PERSONA_RAG_QUALITY_GENERATION_THINK=true
PERSONA_RAG_QUALITY_GENERATION_REFINE_PASSES=
PERSONA_RAG_LOW_GENERATION_MODEL=qwen3.5:9b
PERSONA_RAG_MEDIUM_GENERATION_MODEL=qwen3.5:9b
PERSONA_RAG_HIGH_GENERATION_MODEL=qwen3.5:9b
PERSONA_RAG_LOW_GENERATION_THINK=true
PERSONA_RAG_MEDIUM_GENERATION_THINK=true
PERSONA_RAG_HIGH_GENERATION_THINK=true
PERSONA_RAG_LOW_GENERATION_THINKING_BUDGET=600
PERSONA_RAG_MEDIUM_GENERATION_THINKING_BUDGET=2000
PERSONA_RAG_HIGH_GENERATION_THINKING_BUDGET=4000
PERSONA_RAG_LOW_GENERATION_REFINE_PASSES=0
PERSONA_RAG_MEDIUM_GENERATION_REFINE_PASSES=0
PERSONA_RAG_HIGH_GENERATION_REFINE_PASSES=0
PERSONA_RAG_MODEL_TIMEOUT_SECONDS=480
PERSONA_RAG_MODEL_KEEP_ALIVE=30s
PERSONA_RAG_MODEL_THINK=true
PERSONA_RAG_MODEL_NUM_PREDICT=1280
PERSONA_RAG_MODEL_TEMPERATURE=0.2
PERSONA_RAG_MODEL_TOP_P=0.9
PERSONA_RAG_BOUNDARY_FAST_PATH_ENABLED=true
PERSONA_RAG_POST_PERSONA_ALIGNMENT_ENABLED=true
PERSONA_RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
PERSONA_RAG_EMBEDDING_TIMEOUT_SECONDS=120
PERSONA_RAG_SPARSE_RETRIEVER=sqlite_fts5
PERSONA_RAG_RETRIEVAL_MODE=hybrid
PERSONA_RAG_RETRIEVAL_FIRST_STAGE_TOP_K=40
PERSONA_RAG_RETRIEVAL_RRF_K=60
PERSONA_RAG_QUERY_REWRITE_ENABLED=true
PERSONA_RAG_QUERY_REWRITE_MAX_QUERIES=3
PERSONA_RAG_QUERY_REWRITE_DENSE=false
PERSONA_RAG_LOCAL_RERANKER_ENABLED=true
PERSONA_RAG_SOURCE_SELECTOR_ENABLED=true
PERSONA_RAG_SOURCE_SELECTOR_INTENT_FILTER_ENABLED=true
PERSONA_RAG_SOURCE_SELECTOR_TOP_K=12
PERSONA_RAG_VECTOR_INDEX_PATH=data/indexes/dense_qwen3_embedding_0_6b.json
PERSONA_RAG_RERANKER_BACKEND=ollama_generate
PERSONA_RAG_RERANKER_MODEL=dengcao/Qwen3-Reranker-0.6B:Q8_0
PERSONA_RAG_RERANKER_HF_MODEL=Qwen/Qwen3-Reranker-0.6B
PERSONA_RAG_RERANKER_HF_CACHE_DIR=models/huggingface
PERSONA_RAG_RERANKER_DEVICE=auto
PERSONA_RAG_RERANKER_BATCH_SIZE=8
PERSONA_RAG_RERANKER_ENABLED=false
PERSONA_RAG_RERANKER_TOP_N=12
PERSONA_RAG_RERANKER_TIMEOUT_SECONDS=120
PERSONA_RAG_EVAL_QUESTIONS_PATH=evals/questions/persona_benchmark_v1.json
PERSONA_RAG_JUDGE_MODEL=qwen3:8b
PERSONA_RAG_JUDGE_TIMEOUT_SECONDS=180
PERSONA_RAG_JUDGE_THRESHOLD=0.7

# External reconstruction / enrichment APIs
# Keep real keys only in local .env. Never use VITE_ for secrets.
PERSONA_RAG_DEEPSEEK_API_KEY=
PERSONA_RAG_DEEPSEEK_MODEL=deepseek-v4-pro
PERSONA_RAG_DEEPSEEK_BASE_URL=https://api.deepseek.com
PERSONA_RAG_DEEPSEEK_TIMEOUT_SECONDS=300
PERSONA_RAG_WEB_RESEARCH_ENABLED=true
PERSONA_RAG_WEB_RESEARCH_PROVIDER=autosearch
PERSONA_RAG_WEB_RESEARCH_MAX_QUERIES=24
PERSONA_RAG_WEB_RESEARCH_MAX_SOURCES=80
PERSONA_RAG_WEB_RESEARCH_MAX_INCLUDED_SOURCES=30
PERSONA_RAG_CRAWLER_PROVIDER=crawl4ai
PERSONA_RAG_CRAWL_TIMEOUT_SECONDS=60

PERSONA_RAG_FOLLOWUP_MODEL=qwen3.5:9b
PERSONA_RAG_FOLLOWUP_THINK=false
PERSONA_RAG_FOLLOWUP_NUM_PREDICT=384
PERSONA_RAG_FOLLOWUP_TIMEOUT_SECONDS=20

# Accounts and SMTP
PERSONA_RAG_AUTH_REQUIRED=true
PERSONA_RAG_AUTH_TOKEN_TTL_HOURS=72
PERSONA_RAG_AUTH_TRUST_PROXY_HEADERS=true
PERSONA_RAG_AUTH_MAX_ACTIVE_LOGIN_IPS=3
PERSONA_RAG_AUTH_CHALLENGE_REQUIRED=true
PERSONA_RAG_AUTH_CHALLENGE_MODE=slider
PERSONA_RAG_AUTH_CHALLENGE_DIFFICULTY=3
PERSONA_RAG_AUTH_CHALLENGE_TTL_SECONDS=180
PERSONA_RAG_AUTH_CHALLENGE_MIN_ELAPSED_MS=800
PERSONA_RAG_AUTH_ADMIN_USERNAME=admin
PERSONA_RAG_AUTH_ADMIN_EMAIL=admin@local.persona-rag
PERSONA_RAG_AUTH_ADMIN_PASSWORD=change_me_in_local_env
PERSONA_RAG_EMAIL_VERIFICATION_TTL_MINUTES=10
PERSONA_RAG_SMTP_HOST=smtp.163.com
PERSONA_RAG_SMTP_PORT=465
PERSONA_RAG_SMTP_SECURITY=ssl
PERSONA_RAG_SMTP_USERNAME=your_163_account@163.com
PERSONA_RAG_SMTP_PASSWORD=your_163_authorization_code
PERSONA_RAG_SMTP_FROM=your_163_account@163.com

# Document reader / OCR-VLM backends
DOCUMENT_READER_ENABLE_DOCLING=true
DOCUMENT_READER_ENABLE_MARKER_SURYA=true
DOCUMENT_READER_ENABLE_PADDLEOCR_VL=false
DOCUMENT_READER_ENABLE_GRANITE_DOCLING=false
DOCUMENT_READER_ENABLE_MINERU=false
DOCUMENT_READER_ENABLE_OLMOCR=false
DOCUMENT_READER_MODEL_CACHE_DIR=models/document_reader
DOCUMENT_READER_MARKER_SURYA_PYTHON=
DOCUMENT_READER_MARKER_SURYA_DEVICE=auto
DOCUMENT_READER_MARKER_SURYA_TIMEOUT_SECONDS=900
DOCUMENT_READER_PADDLEOCR_VL_MODE=http
DOCUMENT_READER_PADDLEOCR_VL_PYTHON=
DOCUMENT_READER_PADDLEOCR_VL_ENDPOINT=http://127.0.0.1:18080
DOCUMENT_READER_PADDLEOCR_VL_DEVICE=gpu
DOCUMENT_READER_PADDLEOCR_VL_TIMEOUT_SECONDS=900

# 2025+ local model candidates installed through configs/model_candidates_2025_plus.json.
# Keep production defaults stable until candidate reports pass persona gates.
# Medium candidates: qwen3.5:9b, ministral-3:14b
# High default: qwen3.5:9b; heavy experimental candidates: batiai/qwen3.6-27b:q3, gemma4:31b
# Judge candidates: qwen3:8b, phi4-reasoning:14b, gpt-oss:20b
# Actor experiment only: coser-llama3.1-8b:q4_k_m
# Windows note: qwen3.5:27b-int4 was checked on 2026-05-06 and Ollama returned "this model requires macOS".

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000

# Portable deployment metadata. These are optional and may be generated by
# scripts/deploy/portable_deploy.*. Keep real secrets only in local .env.
PERSONA_RAG_PUBLIC_URL=
PERSONA_RAG_DEPLOYMENT_MODE=local_lan
PERSONA_RAG_DEPLOYMENT_PROFILE=standard_gpu
